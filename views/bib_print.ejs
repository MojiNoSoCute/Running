<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>พิมพ์เบอร์วิ่ง (Print Official Race BIBs) - <%= settings.event_name %></title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;600;800;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Kanit', sans-serif;
            background-color: #e2e8f0;
        }

        .bib-card {
            background: white;
            border: 4px solid #111;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 30px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            page-break-inside: avoid;
            position: relative;
            height: 380px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .bib-card::before, .bib-card::after {
            content: '';
            position: absolute;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background-color: #cbd5e1;
            border: 2px solid #64748b;
        }

        .bib-card::before { top: 12px; left: 12px; }
        .bib-card::after { top: 12px; right: 12px; }

        .bib-number {
            font-size: 5.5rem;
            font-weight: 900;
            line-height: 1;
            letter-spacing: 2px;
            color: #0f172a;
            text-align: center;
        }

        .bib-category-header {
            border-radius: 8px;
            padding: 6px 12px;
            font-weight: 800;
            font-size: 1.2rem;
            color: white;
            text-align: center;
            letter-spacing: 1px;
        }

        .cat-mini { background: linear-gradient(135deg, #10b981 0%, #059669 100%); }
        .cat-half { background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); }
        .cat-full { background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); }
        .cat-fun  { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }

        @media print {
            body {
                background: white;
                padding: 0;
            }
            .no-print {
                display: none !important;
            }
            .bib-card {
                border: 3px solid #000;
                box-shadow: none;
                margin-bottom: 20px;
            }
        }
    </style>
</head>

<body>

    <!-- Filter & Action Toolbar -->
    <div class="container my-4 no-print">
        <div class="card border-0 shadow-sm p-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <a href="/manage_registrations.php" class="btn btn-outline-dark btn-sm">
                        <i class="fa-solid fa-arrow-left me-1"></i>กลับ
                    </a>
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-print me-2 text-primary"></i>พิมพ์เบอร์วิ่ง (BIBs)</h5>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <form action="/admin/print_bibs" method="GET" class="d-flex gap-2">
                        <select name="category_id" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">-- ทุกประเภทการแข่งขัน --</option>
                            <% categories.forEach(function(c) { %>
                                <option value="<%= c.category_id %>" <%= selectedCat == c.category_id ? 'selected' : '' %>>
                                    <%= c.name %> (<%= c.distance_km %> KM)
                                </option>
                            <% }); %>
                        </select>
                    </form>
                    <button onclick="window.print()" class="btn btn-primary btn-sm fw-bold px-3">
                        <i class="fa-solid fa-print me-1"></i>พิมพ์ทั้งหมด (<%= runners.length %> ใบ)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- BIB Grid -->
    <div class="container">
        <% if (runners.length === 0) { %>
            <div class="card p-5 text-center border-0 shadow-sm">
                <i class="fa-solid fa-triangle-exclamation text-warning fa-3x mb-3"></i>
                <h4 class="fw-bold">ยังไม่มีนักวิ่งที่ชำระเงินและมีหมายเลข BIB</h4>
                <p class="text-muted">โปรดตรวจสอบในหน้าจัดการการสมัคร หรือกดปุ่ม "ออกเลข BIB อัตโนมัติ"</p>
                <div>
                    <a href="/manage_registrations.php" class="btn btn-primary">ไปยังหน้าจัดการการสมัคร</a>
                </div>
            </div>
        <% } else { %>
            <div class="row">
                <% runners.forEach(function(r) { %>
                    <% 
                        let catClass = 'cat-mini';
                        if (r.distance_km >= 40) catClass = 'cat-full';
                        else if (r.distance_km >= 20) catClass = 'cat-half';
                        else if (r.distance_km >= 10) catClass = 'cat-mini';
                        else catClass = 'cat-fun';
                    %>
                    <div class="col-md-6">
                        <div class="bib-card">
                            <!-- Top Event Bar -->
                            <div class="d-flex justify-content-between align-items-center px-3 pt-1">
                                <span class="fw-bold text-muted small"><%= settings.event_name %></span>
                                <span class="text-muted small"><i class="fa-solid fa-calendar me-1"></i><%= settings.event_date %></span>
                            </div>

                            <!-- Category Banner -->
                            <div class="bib-category-header <%= catClass %>">
                                <%= r.category_name.toUpperCase() %> - <%= r.distance_km %> KM
                            </div>

                            <!-- BIB Number Big -->
                            <div class="bib-number">
                                <%= r.bib_number %>
                            </div>

                            <!-- Runner Name & Emergency Info -->
                            <div class="border-top pt-2 mt-2">
                                <div class="d-flex justify-content-between align-items-end">
                                    <div>
                                        <div class="text-muted small">RUNNER NAME</div>
                                        <h4 class="fw-bold text-dark mb-0"><%= r.first_name %> <%= r.last_name %></h4>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-dark fs-6">SIZE: <%= r.shirt_size %></span>
                                        <small class="d-block text-muted mt-1"><i class="fa-solid fa-phone me-1"></i><%= r.phone %></small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

</body>

</html>
