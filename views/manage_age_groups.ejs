<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>จัดการกลุ่มอายุ - Running Admin</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="assets/css/alert-popup.css">
</head>

<body class="bg-light">

    <!-- Top Navbar -->
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <span class="navbar-brand mb-0 h1"><i class="fa-solid fa-users-line me-2"></i>จัดการกลุ่มอายุ (Age Groups Management)</span>
            <a href="admin_index.php" class="btn btn-outline-light btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i>กลับแดชบอร์ด
            </a>
        </div>
    </nav>

    <div class="container">
        <!-- Add / Edit Form Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0" id="form-title">เพิ่มกลุ่มอายุใหม่</h5>
            </div>
            <div class="card-body">
                <form id="age-group-form" action="crud_age_group.php" method="POST">
                    <input type="hidden" name="action" value="create" id="form-action">
                    <input type="hidden" name="age_group_id" id="age_group_id">

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">ประเภทการแข่งขัน</label>
                            <select name="category_id" id="category_id" class="form-select" required>
                                <option value="">-- เลือกประเภทการแข่งขัน --</option>
                                <% categories.forEach(function(cat) { %>
                                    <option value="<%= cat.category_id %>"><%= cat.name %> (<%= cat.distance_km %> KM)</option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">เพศ</label>
                            <select name="gender" id="gender" class="form-select" required>
                                <option value="">-- เลือกเพศ --</option>
                                <option value="M">Male (ชาย)</option>
                                <option value="F">Female (หญิง)</option>
                                <option value="A">All (ทุกเพศ)</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">อายุเริ่มต้น (Min Age)</label>
                            <input type="number" name="min_age" id="min_age" class="form-control" placeholder="เช่น 18" min="0" max="100" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">อายุสิ้นสุด (Max Age)</label>
                            <input type="number" name="max_age" id="max_age" class="form-control" placeholder="เช่น 29" min="0" max="100" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">ชื่อกลุ่ม (Label)</label>
                            <input type="text" name="label" id="label" class="form-control" placeholder="เช่น ชาย 18-29 ปี" required>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-secondary" id="submit-btn">
                            <i class="fa-solid fa-save me-1"></i>บันทึกข้อมูล
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="resetForm()">
                            <i class="fa-solid fa-times me-1"></i>ยกเลิก
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Table Card -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-bold">รายการกลุ่มอายุทั้งหมด (<%= age_groups.length %> กลุ่ม)</h5>
                <div class="input-group" style="width: 300px;">
                    <input type="text" class="form-control" placeholder="ค้นหากลุ่มอายุ..." id="search-input">
                    <button class="btn btn-outline-secondary" type="button"><i class="fa-solid fa-search"></i></button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>ประเภทการแข่งขัน</th>
                                <th>เพศ</th>
                                <th>ช่วงอายุ</th>
                                <th>ชื่อกลุ่ม (Label)</th>
                                <th class="text-center">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody id="age-groups-table">
                            <% if (age_groups.length > 0) { %>
                                <% age_groups.forEach(function(ag) { %>
                                    <tr>
                                        <td><strong>#<%= ag.age_group_id %></strong></td>
                                        <td><%= ag.category_name %></td>
                                        <td>
                                            <% if (ag.gender === 'M') { %>
                                                <span class="badge bg-primary">ชาย</span>
                                            <% } else if (ag.gender === 'F') { %>
                                                <span class="badge bg-danger">หญิง</span>
                                            <% } else { %>
                                                <span class="badge bg-info">ทุกเพศ</span>
                                            <% } %>
                                        </td>
                                        <td><%= ag.min_age %> - <%= ag.max_age %> ปี</td>
                                        <td class="fw-bold"><%= ag.label %></td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-warning me-1" onclick="editAgeGroup(<%= ag.age_group_id %>)">
                                                <i class="fa-solid fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger" onclick="deleteAgeGroup(<%= ag.age_group_id %>)">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="6" class="text-center py-4 text-muted">ยังไม่มีข้อมูลกลุ่มอายุ</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="assets/js/alert-popup.js"></script>
    <script>
        function resetForm() {
            document.getElementById('age-group-form').reset();
            document.getElementById('form-action').value = 'create';
            document.getElementById('age_group_id').value = '';
            document.getElementById('form-title').textContent = 'เพิ่มกลุ่มอายุใหม่';
            document.getElementById('submit-btn').innerHTML = '<i class="fa-solid fa-save me-1"></i>บันทึกข้อมูล';
        }

        function editAgeGroup(id) {
            fetch(`crud_age_group.php?action=get&id=${id}`)
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        const d = res.data;
                        document.getElementById('form-action').value = 'update';
                        document.getElementById('age_group_id').value = d.age_group_id;
                        document.getElementById('category_id').value = d.category_id;
                        document.getElementById('gender').value = d.gender;
                        document.getElementById('min_age').value = d.min_age;
                        document.getElementById('max_age').value = d.max_age;
                        document.getElementById('label').value = d.label;

                        document.getElementById('form-title').textContent = 'แก้ไขกลุ่มอายุ ID #' + d.age_group_id;
                        document.getElementById('submit-btn').innerHTML = '<i class="fa-solid fa-save me-1"></i>อัปเดตข้อมูล';
                        document.getElementById('age-group-form').scrollIntoView({ behavior: 'smooth' });
                    }
                });
        }

        function deleteAgeGroup(id) {
            showConfirm('คุณแน่ใจหรือไม่ที่จะลบกลุ่มอายุนี้?', 'ยืนยันการลบ', () => {
                fetch('crud_age_group.php', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `action=delete&age_group_id=${id}`
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        showSuccess(res.message, 'สำเร็จ', () => location.reload());
                    } else {
                        showError(res.message);
                    }
                });
            });
        }

        document.getElementById('search-input').addEventListener('keyup', function() {
            const val = this.value.toLowerCase();
            const rows = document.querySelectorAll('#age-groups-table tr');
            rows.forEach(r => {
                r.style.display = r.textContent.toLowerCase().includes(val) ? '' : 'none';
            });
        });
    </script>
</body>

</html>
