<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>จัดการตัวเลือกการจัดส่ง - Running Admin</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="assets/css/alert-popup.css">
</head>

<body class="bg-light">

    <!-- Top Navbar -->
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <span class="navbar-brand mb-0 h1"><i class="fa-solid fa-truck-fast me-2"></i>จัดการตัวเลือกการจัดส่ง (Shipping Options Management)</span>
            <a href="admin_index.php" class="btn btn-outline-light btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i>กลับแดชบอร์ด
            </a>
        </div>
    </nav>

    <div class="container">
        <!-- Add / Edit Form Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0" id="form-title">เพิ่มตัวเลือกการจัดส่งใหม่</h5>
            </div>
            <div class="card-body">
                <form id="shipping-form" action="crud_shipping_option.php" method="POST">
                    <input type="hidden" name="action" value="create" id="form-action">
                    <input type="hidden" name="shipping_id" id="shipping_id">

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">รูปแบบการรับ / ผู้ให้บริการ</label>
                            <select name="type" id="type" class="form-select" required>
                                <option value="">-- เลือกรูปแบบการรับ --</option>
                                <option value="EMS">จัดส่งทางไปรษณีย์ด่วนพิเศษ (EMS)</option>
                                <option value="Pickup">รับด้วยตัวเองที่งาน (Pickup)</option>
                                <option value="Kerry">Kerry Express</option>
                                <option value="Flash">Flash Express</option>
                                <option value="J&T">J&T Express</option>
                                <option value="DHL">DHL Express</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">ค่าบริการจัดส่ง (บาท)</label>
                            <input type="number" step="0.01" name="cost" id="cost" class="form-control" value="0.00" min="0" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label">รายละเอียดเพิ่มเติม</label>
                            <textarea name="detail" id="detail" class="form-control" rows="2" placeholder="ระบุรายละเอียดเพิ่มเติม เช่น สถานที่รับ วันเวลา หรือเงื่อนไข"></textarea>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary" id="submit-btn">
                            <i class="fa-solid fa-save me-1"></i>บันทึกข้อมูล
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="resetForm()">
                            <i class="fa-solid fa-times me-1"></i>ยกเลิก
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-success text-white text-center p-2 border-0 shadow-sm">
                    <h5><%= freeCount %></h5>
                    <small>บริการฟรี (0 บาท)</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white text-center p-2 border-0 shadow-sm">
                    <h5><%= lowCount %></h5>
                    <small>1 - 50 บาท</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-dark text-center p-2 border-0 shadow-sm">
                    <h5><%= medCount %></h5>
                    <small>51 - 100 บาท</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-danger text-white text-center p-2 border-0 shadow-sm">
                    <h5><%= highCount %></h5>
                    <small>มากกว่า 100 บาท</small>
                </div>
            </div>
        </div>

        <!-- Table Card -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-bold">รายการตัวเลือกการจัดส่งทั้งหมด (<%= shipping_options.length %> ตัวเลือก)</h5>
                <input type="text" class="form-control form-control-sm" placeholder="ค้นหา..." id="search-input" style="width: 250px;">
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>รูปแบบการรับ</th>
                                <th>ค่าบริการ</th>
                                <th>รายละเอียด</th>
                                <th>วันที่บันทึก</th>
                                <th class="text-center">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody id="shipping-table">
                            <% if (shipping_options.length > 0) { %>
                                <% shipping_options.forEach(function(ship) { %>
                                    <tr>
                                        <td><strong>#<%= ship.shipping_id %></strong></td>
                                        <td class="fw-bold">
                                            <i class="fa-solid fa-truck me-2 text-primary"></i><%= ship.type %>
                                        </td>
                                        <td>
                                            <% if (Number(ship.cost) === 0) { %>
                                                <span class="badge bg-success">ฟรี (0.00 บาท)</span>
                                            <% } else { %>
                                                <span class="badge bg-primary"><%= Number(ship.cost).toFixed(2) %> บาท</span>
                                            <% } %>
                                        </td>
                                        <td><%= ship.detail || '-' %></td>
                                        <td><%= ship.created_at ? ship.created_at.slice(0, 10) : '-' %></td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-warning me-1" onclick="editShipping(<%= ship.shipping_id %>)">
                                                <i class="fa-solid fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger" onclick="deleteShipping(<%= ship.shipping_id %>)">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="6" class="text-center py-4 text-muted">ยังไม่มีข้อมูลการจัดส่ง</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="assets/js/alert-popup.js"></script>
    <script>
        function resetForm() {
            document.getElementById('shipping-form').reset();
            document.getElementById('form-action').value = 'create';
            document.getElementById('shipping_id').value = '';
            document.getElementById('cost').value = '0.00';
            document.getElementById('form-title').textContent = 'เพิ่มตัวเลือกการจัดส่งใหม่';
            document.getElementById('submit-btn').innerHTML = '<i class="fa-solid fa-save me-1"></i>บันทึกข้อมูล';
        }

        function editShipping(id) {
            fetch(`crud_shipping_option.php?action=get&id=${id}`)
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        const d = res.data;
                        document.getElementById('form-action').value = 'update';
                        document.getElementById('shipping_id').value = d.shipping_id;
                        document.getElementById('type').value = d.type;
                        document.getElementById('cost').value = d.cost;
                        document.getElementById('detail').value = d.detail || '';

                        document.getElementById('form-title').textContent = 'แก้ไขตัวเลือกการจัดส่ง ID #' + d.shipping_id;
                        document.getElementById('submit-btn').innerHTML = '<i class="fa-solid fa-save me-1"></i>อัปเดตข้อมูล';
                        document.getElementById('shipping-form').scrollIntoView({ behavior: 'smooth' });
                    }
                });
        }

        function deleteShipping(id) {
            showConfirm('คุณแน่ใจหรือไม่ที่จะลบตัวเลือกการจัดส่งนี้?', 'ยืนยันการลบ', () => {
                fetch('crud_shipping_option.php', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `action=delete&shipping_id=${id}`
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        showSuccess(res.message, 'สำเร็จ', () => location.reload());
                    } else {
                        showError(res.message);
                    }
                });
            });
        }

        document.getElementById('search-input').addEventListener('keyup', function() {
            const val = this.value.toLowerCase();
            const rows = document.querySelectorAll('#shipping-table tr');
            rows.forEach(r => {
                r.style.display = r.textContent.toLowerCase().includes(val) ? '' : 'none';
            });
        });
    </script>
</body>

</html>
