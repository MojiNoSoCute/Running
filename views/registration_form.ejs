    <!-- Pricing Dataset Embedded -->
    <script>
        const priceRates = <%- JSON.stringify(price_rates) %>;
        const categories = <%- JSON.stringify(categories) %>;

        function calculateLiveFee() {
            const selectedCatInput = document.querySelector('input[name="category_id"]:checked');
            const catId = selectedCatInput ? Number(selectedCatInput.value) : 1;
            const isDisabled = document.getElementById('is_disabled_fast').checked;
            const birthDateVal = document.getElementById('birth-date').value;
            
            let age = 30;
            if (birthDateVal) {
                const birthYear = new Date(birthDateVal).getFullYear();
                age = 2025 - birthYear;
            }

            const catRates = priceRates.filter(p => p.category_id === catId);
            let chosenRate = catRates.find(p => p.runner_type === 'Standard') || catRates[0] || { amount: 500 };
            let rateLabel = 'อัตราปกติ (Standard)';

            if (isDisabled) {
                const dis = catRates.find(p => p.runner_type === 'Disabled');
                if (dis) {
                    chosenRate = dis;
                    rateLabel = 'สิทธิ์ผู้พิการ (Disabled Discount)';
                }
            } else if (age >= 70) {
                const sen = catRates.find(p => p.runner_type === 'Senior 70+' || p.runner_type.includes('70'));
                if (sen) {
                    chosenRate = sen;
                    rateLabel = 'ผู้สูงอายุ 70 ปีขึ้นไป (Senior Discount)';
                }
            } else if (age < 23) {
                const stu = catRates.find(p => p.runner_type === 'Student');
                if (stu) {
                    chosenRate = stu;
                    rateLabel = 'นักเรียน / นักศึกษา (Student Discount)';
                }
            }

            const shipSelect = document.getElementById('shipping_select');
            const shipCost = Number(shipSelect.options[shipSelect.selectedIndex]?.dataset.cost || 0);

            const catAmount = Number(chosenRate.amount);
            const totalAmount = catAmount + shipCost;

            document.getElementById('rate-label').textContent = rateLabel;
            document.getElementById('fee-category').textContent = catAmount.toFixed(2);
            document.getElementById('fee-shipping').textContent = shipCost.toFixed(2);
            document.getElementById('total-fee-display').textContent = totalAmount.toFixed(2) + ' ฿';
        }

        function handleFastRegister(e) {
            e.preventDefault();
            const form = document.getElementById('fast-reg-form');
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());

            fetch('/api/register-fast', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    showSuccess('สมัครเข้าร่วมการแข่งขันเรียบร้อยแล้ว!', 'สมัครสำเร็จ', () => {
                        window.location.href = res.redirectUrl || `/payment_form.php?reg_id=${res.reg_id}`;
                    });
                } else {
                    showError(res.message || 'เกิดข้อผิดพลาดในการลงทะเบียน');
                }
            })
            .catch(err => {
                showError('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์');
            });
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', calculateLiveFee);
    </script>

    <!-- Bootstrap 5 JS -->
