<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ชำระเงิน & แจ้งสลิป - <%= settings.event_name %></title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/assets/css/alert-popup.css">
    <style>
        body {
            font-family: 'Kanit', sans-serif;
            background-color: #f1f5f9;
        }

        .payment-card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
            overflow: hidden;
        }

        .qr-container {
            background: white;
            border: 2px solid #002b49;
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0, 43, 73, 0.08);
        }

        .promptpay-header {
            background-color: #002b49;
            color: white;
            border-radius: 10px 10px 0 0;
            padding: 10px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .slip-preview-box {
            max-height: 220px;
            border-radius: 12px;
            border: 2px dashed #cbd5e1;
            padding: 10px;
            text-align: center;
            display: none;
        }

        .slip-preview-box img {
            max-height: 200px;
            border-radius: 8px;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/index.php">
                <i class="fa-solid fa-person-running text-primary me-2"></i><%= settings.event_name %>
            </a>
            <div class="ms-auto">
                <a href="/index.php" class="btn btn-outline-light btn-sm me-2">
                    <i class="fa-solid fa-home me-1"></i>หน้าแรก
                </a>
                <a href="/check_status.php" class="btn btn-outline-light btn-sm me-2">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>ค้นหาสถานะ
                </a>
                <a href="/admin_index.php" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-user-shield me-1"></i>ผู้ดูแลระบบ
                </a>
            </div>
        </div>
    </nav>

    <div class="container mb-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <div class="card payment-card mb-4">
                    <div class="bg-dark text-white p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h3 class="fw-bold mb-1"><i class="fa-solid fa-qrcode text-warning me-2"></i>ชำระเงินค่าสมัครวิ่ง (PromptPay QR & Slip)</h3>
                                <p class="mb-0 text-white-50">สแกนจ่ายผ่านแอปธนาคารไทยทุกแห่ง แล้วแนบหลักฐานการโอนเงิน</p>
                            </div>
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6">สะดวก รวดเร็ว ปลอดภัย</span>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <form id="payment-form" onsubmit="handlePaymentSubmit(event)">
                            <div class="row g-4">
                                
                                <!-- Left Column: Selection & QR Code -->
                                <div class="col-lg-5">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">1. เลือกรายการสมัครที่ต้องการชำระ <span class="text-danger">*</span></label>
                                        <select name="reg_id" id="reg_id_select" class="form-select form-select-lg" required onchange="onRegistrationChanged(this)">
                                            <option value="">-- เลือกรายการสมัคร (รอชำระ) --</option>
                                            <% pendingRegistrations.forEach(function(reg) { %>
                                                <option value="<%= reg.reg_id %>" 
                                                        data-amount="<%= reg.total_amount %>" 
                                                        data-name="<%= reg.first_name %> <%= reg.last_name %>"
                                                        data-cat="<%= reg.category_name %>"
                                                        data-dist="<%= reg.distance_km %>"
                                                        data-shirt="<%= reg.shirt_size %>"
                                                        data-shipcost="<%= reg.shipping_cost %>"
                                                        data-fee="<%= reg.amount %>"
                                                        <%= selectedRegId === reg.reg_id ? 'selected' : '' %>>
                                                    #<%= reg.reg_id %> - <%= reg.first_name %> <%= reg.last_name %> (<%= reg.category_name %> - <%= reg.total_amount %> ฿)
                                                </option>
                                            <% }); %>
                                        </select>
                                    </div>

                                    <!-- QR Code Box -->
                                    <div class="qr-container mt-3">
                                        <div class="promptpay-header mb-3">
                                            <i class="fa-solid fa-bolt me-1"></i> THAI QR PAYMENT / PROMPTPAY
                                        </div>
                                        <div id="qr-image-wrapper">
                                            <% if (promptPayQr) { %>
                                                <img src="<%= promptPayQr %>" alt="PromptPay QR" id="qr-img" class="img-fluid rounded mb-2" style="max-width: 220px;">
                                            <% } else { %>
                                                <img src="" alt="PromptPay QR" id="qr-img" class="img-fluid rounded mb-2" style="max-width: 220px; display: none;">
                                                <div id="qr-placeholder" class="py-4 text-muted">
                                                    <i class="fa-solid fa-qrcode fa-4x mb-2 text-secondary"></i>
                                                    <p class="small mb-0">โปรดเลือกรายการสมัครด้านบนเพื่อสร้าง QR Code ยอดตรง</p>
                                                </div>
                                            <% } %>
                                        </div>
                                        <div class="mt-2">
                                            <small class="text-muted d-block">พร้อมเพย์: <strong><%= settings.promptpay_number %></strong></small>
                                            <small class="text-muted d-block"><%= settings.promptpay_name %></small>
                                        </div>
                                    </div>

                                    <!-- Bank Account Card -->
                                    <div class="card bg-light border-0 p-3 mt-3 rounded-3">
                                        <small class="fw-bold text-muted mb-1 d-block"><i class="fa-solid fa-building-columns text-primary me-1"></i>บัญชีธนาคารสำหรับการโอน:</small>
                                        <div class="fw-bold text-dark"><%= settings.bank_name %></div>
                                        <div class="d-flex justify-content-between align-items-center mt-1">
                                            <code class="fs-5 fw-bold text-primary"><%= settings.bank_account_no %></code>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="copyAccountNo('<%= settings.bank_account_no %>')">
                                                <i class="fa-solid fa-copy me-1"></i>คัดลอก
                                            </button>
                                        </div>
                                        <small class="text-muted mt-1"><%= settings.bank_account_name %></small>
                                    </div>
                                </div>

                                <!-- Right Column: Payment Details & Slip Upload -->
                                <div class="col-lg-7">
                                    <div class="p-3 bg-light rounded-3 border mb-3">
                                        <h6 class="fw-bold text-primary mb-2"><i class="fa-solid fa-receipt me-2"></i>สรุปรายละเอียดรายการ</h6>
                                        <div class="row g-2 small">
                                            <div class="col-6 text-muted">ชื่อผู้สมัคร: <strong class="text-dark" id="disp-name"><%= selectedReg ? (selectedReg.first_name + ' ' + selectedReg.last_name) : '-' %></strong></div>
                                            <div class="col-6 text-muted">ระยะทาง: <strong class="text-dark" id="disp-cat"><%= selectedReg ? (selectedReg.category_name + ' (' + selectedReg.distance_km + ' KM)') : '-' %></strong></div>
                                            <div class="col-6 text-muted">ไซส์เสื้อ: <strong class="text-dark" id="disp-shirt"><%= selectedReg ? selectedReg.shirt_size : '-' %></strong></div>
                                            <div class="col-6 text-muted">ค่าสมัคร + ค่าจัดส่ง: <strong class="text-dark" id="disp-breakdown"><%= selectedReg ? (selectedReg.amount + ' + ' + selectedReg.shipping_cost + ' ฿') : '-' %></strong></div>
                                        </div>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold">จำนวนเงินที่โอน (บาท) <span class="text-danger">*</span></label>
                                            <input type="number" step="0.01" name="total_amount" id="total_amount" class="form-control form-control-lg fw-bold text-success" required placeholder="0.00" value="<%= selectedReg ? selectedReg.total_amount : '' %>">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold">ช่องทางที่โอน <span class="text-danger">*</span></label>
                                            <select name="payment_method" class="form-select form-select-lg" required>
                                                <option value="QR Code" selected>พร้อมเพย์ QR Code</option>
                                                <option value="Bank Transfer">โอนผ่านแอปธนาคาร (Bank Transfer)</option>
                                                <option value="Cash">เงินสด (Cash)</option>
                                            </select>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label fw-bold">วันและเวลาที่โอนเงิน <span class="text-danger">*</span></label>
                                            <input type="datetime-local" name="payment_time" id="payment_time" class="form-control" required>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label fw-bold">เลขอ้างอิงสลิป / รหัสธุรกรรม</label>
                                            <input type="text" name="transaction_ref" id="transaction_ref" class="form-control" placeholder="เช่น 20260315-KBANK-012">
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label fw-bold"><i class="fa-solid fa-image text-primary me-1"></i>แนบรูปภาพสลิปหลักฐานการโอน</label>
                                            <input type="file" id="slip-file" accept="image/*" class="form-control" onchange="previewSlip(event)">
                                            <input type="hidden" name="slip_url" id="slip_url_base64">
                                            
                                            <div id="slip-preview-container" class="slip-preview-box mt-2">
                                                <img src="" id="slip-preview-img" alt="Slip Preview">
                                                <div class="small text-muted mt-1">รูปสลิปที่แนบ</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-4">
                                        <button type="submit" class="btn btn-warning btn-lg w-100 py-3 fw-bold text-dark fs-5 shadow">
                                            <i class="fa-solid fa-check-circle me-2"></i>บันทึกการแจ้งชำระเงิน
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="text-center">
                    <a href="/registration_form.php" class="btn btn-outline-secondary me-2"><i class="fa-solid fa-arrow-left me-1"></i>สมัครคนเพิ่ม</a>
                    <a href="/check_status.php" class="btn btn-outline-primary"><i class="fa-solid fa-magnifying-glass me-1"></i>ค้นหาสถานะ & พิมพ์บัตรวิ่ง</a>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/alert-popup.js"></script>
    <script>
        // Set current time
        document.addEventListener('DOMContentLoaded', () => {
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            document.getElementById('payment_time').value = now.toISOString().slice(0, 16);

            const select = document.getElementById('reg_id_select');
            if (select.value) {
                onRegistrationChanged(select);
            }
        });

        function copyAccountNo(text) {
            navigator.clipboard.writeText(text);
            showInfo('คัดลอกเลขที่บัญชี ' + text + ' แล้ว');
        }

        function onRegistrationChanged(select) {
            const opt = select.options[select.selectedIndex];
            if (!opt || !opt.value) {
                document.getElementById('total_amount').value = '';
                document.getElementById('disp-name').textContent = '-';
                document.getElementById('disp-cat').textContent = '-';
                document.getElementById('disp-shirt').textContent = '-';
                document.getElementById('disp-breakdown').textContent = '-';
                document.getElementById('qr-img').style.display = 'none';
                document.getElementById('qr-placeholder').style.display = 'block';
                return;
            }

            const amount = parseFloat(opt.dataset.amount || 0);
            document.getElementById('total_amount').value = amount.toFixed(2);
            document.getElementById('disp-name').textContent = opt.dataset.name || '-';
            document.getElementById('disp-cat').textContent = (opt.dataset.cat || '') + ' (' + (opt.dataset.dist || '') + ' KM)';
            document.getElementById('disp-shirt').textContent = opt.dataset.shirt || '-';
            document.getElementById('disp-breakdown').textContent = (opt.dataset.fee || '0') + ' + ' + (opt.dataset.shipcost || '0') + ' = ' + amount.toFixed(2) + ' ฿';

            // Fetch dynamic QR Code
            fetch(`/api/promptpay-qr?amount=${amount}`)
                .then(r => r.json())
                .then(res => {
                    if (res.success && res.qrImage) {
                        const img = document.getElementById('qr-img');
                        img.src = res.qrImage;
                        img.style.display = 'inline-block';
                        document.getElementById('qr-placeholder').style.display = 'none';
                    }
                });
        }

        function previewSlip(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const base64 = e.target.result;
                    document.getElementById('slip_url_base64').value = base64;
                    document.getElementById('slip-preview-img').src = base64;
                    document.getElementById('slip-preview-container').style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        }

        function handlePaymentSubmit(e) {
            e.preventDefault();
            const form = document.getElementById('payment-form');
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());

            fetch('/save_payment.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    showSuccess('แจ้งชำระเงินเรียบร้อยแล้ว! เจ้าหน้าที่จะตรวจสอบยอดเงินและออกหมายเลข BIB ให้ท่าน', 'ชำระเงินสำเร็จ', () => {
                        window.location.href = `/check_status.php?q=${data.reg_id}`;
                    });
                } else {
                    showError(res.message || 'เกิดข้อผิดพลาดในการบันทึกการชำระเงิน');
                }
            })
            .catch(err => {
                showError('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์');
            });
        }
    </script>
</body>

</html>
