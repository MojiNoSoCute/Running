    <title>เพิ่มประเภทการแข่งขัน</title>
</head>

<body class="bg-light">
    <div class="container mt-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-success text-white fw-bold">
                <i class="fa-solid fa-layer-group me-2"></i>ข้อมูลประเภทการแข่งขัน (Race Category)
            </div>
            <div class="card-body">
                <form action="save_category.php" method="POST">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">ชื่อประเภทการแข่งขัน</label>
                            <input type="text" name="name" class="form-control" placeholder="เช่น Fun Run" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">ระยะทาง (กม.)</label>
                            <input type="number" step="0.01" name="distance_km" class="form-control" placeholder="เช่น 5.00" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">เวลาปล่อยตัว</label>
                            <input type="time" name="start_time" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">เวลาจำกัด (Cut-off)</label>
                            <input type="time" name="time_limit" class="form-control" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label">ของที่ระลึกที่ได้รับ</label>
                            <input type="text" name="giveaway_type" class="form-control" placeholder="เช่น เสื้อ + เหรียญที่ระลึก">
