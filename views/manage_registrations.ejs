<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>จัดการการสมัคร - <%= settings.event_name %></title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/assets/css/alert-popup.css">
    <style>
        body {
            font-family: 'Kanit', sans-serif;
            background-color: #f1f5f9;
        }
    </style>
</head>

<body>

    <!-- Top Navbar -->
    <nav class="navbar navbar-dark bg-dark mb-4 sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/admin_index.php">
                <i class="fa-solid fa-clipboard-check text-primary me-2"></i>จัดการการสมัครวิ่ง (<%= settings.event_name %>)
            </a>
            <div class="ms-auto">
                <button onclick="autoGenerateBibs()" class="btn btn-outline-warning btn-sm me-2">
                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i>ออก BIB อัตโนมัติ
                </button>
                <a href="/export_registrations.php" class="btn btn-success btn-sm me-2">
                    <i class="fa-solid fa-file-csv me-1"></i>ส่งออก CSV
                </a>
                <a href="/admin_index.php" class="btn btn-outline-light btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i>กลับแดชบอร์ด
                </a>
            </div>
        </div>
    </nav>

    <div class="container mb-5">
        <!-- Filter Card -->
        <div class="card border-0 shadow-sm mb-4 rounded-4">
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">กรองตามประเภทการแข่งขัน</label>
                        <select class="form-select" id="cat-filter" onchange="applyFilters()">
                            <option value="">ทั้งหมดทุกประเภท</option>
                            <% categories.forEach(function(cat) { %>
                                <option value="<%= cat.name %>"><%= cat.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">กรองตามสถานะ</label>
                        <select class="form-select" id="status-filter" onchange="applyFilters()">
                            <option value="">ทั้งหมดทุกสถานะ</option>
                            <option value="Paid">ชำระเงินแล้ว (Paid)</option>
                            <option value="Pending">รอชำระเงิน (Pending)</option>
                            <option value="Cancelled">ยกเลิก (Cancelled)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">ค้นหาข้อมูล</label>
                        <input type="text" class="form-control" placeholder="ค้นหาชื่อ, เบอร์โทร, BIB, เลขบัตร..." id="search-input" onkeyup="applyFilters()">
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <a href="/registration_form.php" class="btn btn-primary w-100 fw-bold">
                            <i class="fa-solid fa-user-plus me-1"></i>สมัครเพิ่ม
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table Card -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-list me-2 text-primary"></i>รายการสมัครวิ่งทั้งหมด (<%= registrations.length %> รายการ)</h5>
                <div>
                    <a href="/admin/checkin" class="btn btn-outline-success btn-sm me-1"><i class="fa-solid fa-clipboard-user me-1"></i>จุดเช็คอิน</a>
                    <a href="/admin/print_bibs" class="btn btn-outline-dark btn-sm"><i class="fa-solid fa-print me-1"></i>พิมพ์ BIB</a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Reg ID</th>
                                <th>นักวิ่ง</th>
                                <th>ประเภทการแข่งขัน</th>
                                <th>ไซส์เสื้อ</th>
                                <th>ยอดชำระ</th>
                                <th>สถานะ</th>
                                <th>BIB Number</th>
                                <th>รับของ</th>
                                <th class="text-center">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody id="regs-table">
                            <% if (registrations.length > 0) { %>
                                <% registrations.forEach(function(reg) { %>
                                    <tr data-cat="<%= reg.category_name %>" data-status="<%= reg.status %>">
                                        <td class="fw-bold">#<%= reg.reg_id %></td>
                                        <td>
                                            <div class="fw-bold text-dark"><%= reg.first_name %> <%= reg.last_name %></div>
                                            <small class="text-muted"><i class="fa-solid fa-phone me-1"></i><%= reg.phone %></small>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary"><%= reg.category_name %> (<%= reg.distance_km %> KM)</span>
                                        </td>
                                        <td><span class="badge bg-light text-dark border"><%= reg.shirt_size %></span></td>
                                        <td>
                                            <strong><%= Number(reg.total_amount || reg.amount).toFixed(2) %> ฿</strong>
                                            <small class="d-block text-muted">(+<%= Number(reg.shipping_cost).toFixed(2) %> <%= reg.shipping_type %>)</small>
                                        </td>
                                        <td>
                                            <% if (reg.status === 'Paid') { %>
                                                <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>ชำระแล้ว</span>
                                            <% } else if (reg.status === 'Pending') { %>
                                                <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i>รอชำระ</span>
                                            <% } else { %>
                                                <span class="badge bg-danger"><%= reg.status %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (reg.bib_number) { %>
                                                <span class="badge bg-primary fs-6 px-3 py-1"><%= reg.bib_number %></span>
                                            <% } else { %>
                                                <span class="text-muted">-</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (reg.checked_in) { %>
                                                <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>รับแล้ว</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary">ยังไม่ได้รับ</span>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <a href="/e-ticket/<%= reg.reg_id %>" target="_blank" class="btn btn-sm btn-outline-info" title="ดู E-Ticket">
                                                    <i class="fa-solid fa-ticket"></i>
                                                </a>
                                                <button class="btn btn-sm btn-warning" onclick="editRegistration(<%= reg.reg_id %>)" title="แก้ไข">
                                                    <i class="fa-solid fa-edit"></i>
                                                </button>
                                                <% if (reg.status === 'Pending') { %>
                                                    <a href="/payment_form.php?reg_id=<%= reg.reg_id %>" class="btn btn-sm btn-success" title="แจ้งชำระ">
                                                        <i class="fa-solid fa-qrcode"></i>
                                                    </a>
                                                    <button class="btn btn-sm btn-danger" onclick="cancelRegistration(<%= reg.reg_id %>)" title="ยกเลิกการสมัคร">
                                                        <i class="fa-solid fa-ban"></i>
                                                    </button>
                                                <% } %>
                                                <button class="btn btn-sm btn-outline-danger" onclick="deleteRegistration(<%= reg.reg_id %>)" title="ลบ">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="9" class="text-center py-4 text-muted">ยังไม่มีข้อมูลการสมัคร</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="editModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i>แก้ไขข้อมูลการสมัคร</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="edit-reg-form">
                        <input type="hidden" id="edit_reg_id">
                        <div class="mb-3">
                            <label class="form-label fw-bold">ไซส์เสื้อ</label>
                            <select class="form-select" id="edit_shirt_size">
                                <option value="S">S</option>
                                <option value="M">M</option>
                                <option value="L">L</option>
                                <option value="XL">XL</option>
                                <option value="2XL">2XL</option>
                                <option value="3XL">3XL</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">หมายเลข BIB</label>
                            <input type="text" class="form-control" id="edit_bib_number" placeholder="เช่น M001 หรือ 1001">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">สถานะการสมัคร</label>
                            <select class="form-select" id="edit_status">
                                <option value="Pending">รอชำระเงิน (Pending)</option>
                                <option value="Paid">ชำระเงินแล้ว (Paid)</option>
                                <option value="Cancelled">ยกเลิก (Cancelled)</option>
                            </select>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="edit_checked_in">
                            <label class="form-check-label fw-bold" for="edit_checked_in">
                                เช็คอินรับอุปกรณ์ (BIB / เสื้อ) เรียบร้อยแล้ว
                            </label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="button" class="btn btn-primary" onclick="saveRegChanges()">บันทึกการเปลี่ยนแปลง</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/alert-popup.js"></script>
    <script>
        function applyFilters() {
            const cat = document.getElementById('cat-filter').value;
            const status = document.getElementById('status-filter').value;
            const search = document.getElementById('search-input').value.toLowerCase();
            const rows = document.querySelectorAll('#regs-table tr');

            rows.forEach(r => {
                let show = true;
                if (cat && r.dataset.cat !== cat) show = false;
                if (status && r.dataset.status !== status) show = false;
                if (search && !r.textContent.toLowerCase().includes(search)) show = false;
                r.style.display = show ? '' : 'none';
            });
        }

        function editRegistration(id) {
            fetch(`/crud_registration.php?action=get&id=${id}`)
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        const d = res.data;
                        document.getElementById('edit_reg_id').value = d.reg_id;
                        document.getElementById('edit_shirt_size').value = d.shirt_size;
                        document.getElementById('edit_bib_number').value = d.bib_number || '';
                        document.getElementById('edit_status').value = d.status;
                        document.getElementById('edit_checked_in').checked = !!d.checked_in;

                        new bootstrap.Modal(document.getElementById('editModal')).show();
                    }
                });
        }

        function saveRegChanges() {
            const id = document.getElementById('edit_reg_id').value;
            const size = document.getElementById('edit_shirt_size').value;
            const bib = document.getElementById('edit_bib_number').value;
            const status = document.getElementById('edit_status').value;
            const checkedIn = document.getElementById('edit_checked_in').checked ? 1 : 0;

            fetch('/crud_registration.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `action=update&reg_id=${id}&shirt_size=${size}&bib_number=${bib}&status=${status}&checked_in=${checkedIn}`
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    showSuccess(res.message, 'สำเร็จ', () => location.reload());
                } else {
                    showError(res.message);
                }
            });
        }

        function autoGenerateBibs() {
            showConfirm('ระบบจะทำการออกหมายเลข BIB ให้อัตโนมัติสำหรับรายการที่ชำระเงินแล้วแต่ยังไม่มี BIB ใช่หรือไม่?', 'ออกเลข BIB อัตโนมัติ', () => {
                fetch('/crud_registration.php', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'action=auto_generate_bibs'
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        showSuccess(res.message, 'สำเร็จ', () => location.reload());
                    } else {
                        showError(res.message);
                    }
                });
            });
        }

        function cancelRegistration(id) {
            showConfirm('คุณแน่ใจหรือไม่ที่จะยกเลิกการสมัคร ID #' + id + '?', 'ยืนยันการยกเลิก', () => {
                fetch('/crud_registration.php', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `action=cancel&reg_id=${id}`
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        showSuccess(res.message, 'สำเร็จ', () => location.reload());
                    } else {
                        showError(res.message);
                    }
                });
            });
        }

        function deleteRegistration(id) {
            showConfirm('คุณแน่ใจหรือไม่ที่จะลบการสมัคร ID #' + id + '?', 'ยืนยันการลบ', () => {
                fetch('/crud_registration.php', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `action=delete&reg_id=${id}`
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        showSuccess(res.message, 'สำเร็จ', () => location.reload());
                    } else {
                        showError(res.message);
                    }
                });
            });
        }
    </script>
</body>

</html>
