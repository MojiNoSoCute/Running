        <!-- Recent Registrations & Categories Summary -->
        <div class="row g-4">
            <!-- Recent Registrations -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0 fw-bold"><i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i>การสมัครล่าสุด</h5>
                        <a href="/manage_registrations.php" class="btn btn-sm btn-primary">ดูทั้งหมด</a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Reg ID</th>
                                        <th>นักวิ่ง</th>
                                        <th>ระยะทาง</th>
                                        <th>สถานะ</th>
                                        <th>BIB</th>
                                        <th>วันที่สมัคร</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (recentRegistrations.length > 0) { %>
                                        <% recentRegistrations.forEach(function(reg) { %>
                                            <tr>
                                                <td class="fw-bold">#<%= reg.reg_id %></td>
                                                <td><%= reg.first_name %> <%= reg.last_name %></td>
                                                <td><span class="badge bg-secondary"><%= reg.category_name %></span></td>
                                                <td>
                                                    <% if (reg.status === 'Paid') { %>
                                                        <span class="badge bg-success">ชำระแล้ว</span>
                                                    <% } else if (reg.status === 'Pending') { %>
                                                        <span class="badge bg-warning text-dark">รอชำระ</span>
                                                    <% } else { %>
                                                        <span class="badge bg-danger"><%= reg.status %></span>
                                                    <% } %>
                                                </td>
                                                <td><strong class="text-primary"><%= reg.bib_number || '-' %></strong></td>
                                                <td><%= reg.reg_date %></td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr><td colspan="6" class="text-center py-4 text-muted">ยังไม่มีข้อมูลการสมัคร</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Categories Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="card-title mb-0 fw-bold"><i class="fa-solid fa-chart-pie me-2 text-primary"></i>สรุปสัดส่วนตามประเภท</h5>
                    </div>
                    <div class="card-body">
                        <% categoryCounts.forEach(function(cat) { %>
                            <div class="mb-4">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-bold"><%= cat.name %> (<%= cat.distance_km %> KM)</span>
                                    <span><strong><%= cat.total %></strong> คน (ชำระ <%= cat.paid %>)</span>
                                </div>
                                <div class="progress" style="height: 10px; border-radius: 5px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: <%= regCount > 0 ? (cat.total / regCount * 100) : 0 %>%"></div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/alert-popup.js"></script>
    <script>
        function autoGenerateBibs() {
            showConfirm('ระบบจะทำการออกหมายเลข BIB ให้อัตโนมัติสำหรับรายการที่ชำระเงินแล้วแต่ยังไม่มี BIB ใช่หรือไม่?', 'ออกเลข BIB อัตโนมัติ', () => {
                fetch('/crud_registration.php', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'action=auto_generate_bibs'
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        showSuccess(res.message, 'สำเร็จ', () => location.reload());
                    } else {
                        showError(res.message);
                    }
                });
            });
        }
    </script>
</body>

</html>
