                            <div class="col-md-3 col-sm-6">
                                <a href="/manage_categories.php" class="btn btn-outline-secondary w-100 quick-action-btn">
                                    <i class="fa-solid fa-layer-group fa-2x mb-2"></i>
                                    <span>ประเภทระยะทาง</span>
                                    <small class="text-muted">(<%= categoriesCount %> ประเภท)</small>
                                </a>
