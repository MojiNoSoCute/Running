                        </a>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-sm-6">
                <div class="card bg-warning text-dark dashboard-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-dark-50">รายได้รวมที่ยืนยันแล้ว</small>
                                <h2 class="my-2 fw-bold"><%= Number(totalRevenue).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></h2>
