                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-3 col-sm-6">
                                <a href="/manage_registrations.php" class="btn btn-outline-primary w-100 quick-action-btn">
                                    <i class="fa-solid fa-clipboard-check fa-2x mb-2"></i>
                                    <span class="fw-bold">จัดการการสมัคร</span>
                                    <small class="text-muted">(<%= regCount %> รายการ)</small>
                                </a>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <a href="/manage_payments.php" class="btn btn-outline-warning text-dark w-100 quick-action-btn">
                                    <i class="fa-solid fa-receipt fa-2x mb-2 text-warning"></i>
                                    <span class="fw-bold">จัดการการชำระเงิน</span>
                                    <small class="text-muted">(<%= paidCount %> ชำระแล้ว)</small>
                                </a>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <a href="/admin/checkin" class="btn btn-outline-success w-100 quick-action-btn">
                                    <i class="fa-solid fa-clipboard-user fa-2x mb-2 text-success"></i>
                                    <span class="fw-bold">จุดเช็คอินรับ Race Kit</span>
                                    <small class="text-muted">(<%= checkedInCount %> รับแล้ว)</small>
                                </a>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <a href="/admin/print_bibs" class="btn btn-outline-dark w-100 quick-action-btn">
                                    <i class="fa-solid fa-print fa-2x mb-2"></i>
                                    <span class="fw-bold">พิมพ์เบอร์วิ่ง (BIBs)</span>
                                    <small class="text-muted">(พิมพ์การ์ดวิ่ง)</small>
                                </a>
                            </div>

                            <div class="col-md-3 col-sm-6">
                                <a href="/manage_runners.php" class="btn btn-outline-secondary w-100 quick-action-btn">
                                    <i class="fa-solid fa-user-gear fa-2x mb-2"></i>
                                    <span>ข้อมูลนักวิ่ง</span>
                                    <small class="text-muted">(<%= runnerCount %> คน)</small>
                                </a>
