<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>จัดการการชำระเงิน - Running Admin</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="assets/css/alert-popup.css">
</head>

<body class="bg-light">

    <!-- Top Navbar -->
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <span class="navbar-brand mb-0 h1"><i class="fa-solid fa-receipt me-2"></i>จัดการการชำระเงิน (Payments Management)</span>
            <a href="admin_index.php" class="btn btn-outline-light btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i>กลับแดชบอร์ด
            </a>
        </div>
    </nav>

    <div class="container">
        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-success text-white shadow-sm border-0">
                    <div class="card-body text-center">
                        <h4 class="fw-bold"><%= Number(successRevenue).toLocaleString('th-TH', { minimumFractionDigits: 2 }) %></h4>
                        <small>รายได้รวม (บาท)</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white shadow-sm border-0">
                    <div class="card-body text-center">
                        <h4 class="fw-bold"><%= successCount %></h4>
                        <small>ชำระสำเร็จ</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-dark shadow-sm border-0">
                    <div class="card-body text-center">
                        <h4 class="fw-bold"><%= pendingCount %></h4>
                        <small>รอตรวจสอบ</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-danger text-white shadow-sm border-0">
                    <div class="card-body text-center">
                        <h4 class="fw-bold"><%= failedCount %></h4>
                        <small>ไม่สำเร็จ</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">สถานะ</label>
                        <select class="form-select" id="status-filter" onchange="applyFilters()">
                            <option value="">ทั้งหมด</option>
                            <option value="Success">สำเร็จ (Success)</option>
                            <option value="Pending">รอตรวจสอบ (Pending)</option>
                            <option value="Failed">ไม่สำเร็จ (Failed)</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">วิธีการชำระ</label>
                        <select class="form-select" id="method-filter" onchange="applyFilters()">
                            <option value="">ทั้งหมด</option>
                            <option value="Bank Transfer">โอนเงิน (Bank Transfer)</option>
                            <option value="QR Code">QR Code</option>
                            <option value="Cash">เงินสด (Cash)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">ค้นหา</label>
                        <input type="text" class="form-control" placeholder="ชื่อนักวิ่ง, Ref ID..." id="search-input" onkeyup="applyFilters()">
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <a href="payment_form.php" class="btn btn-primary w-100">
                            <i class="fa-solid fa-plus me-1"></i>แจ้งชำระเพิ่ม
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Data Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">รายการการชำระเงินทั้งหมด (<%= payments.length %> รายการ)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Payment ID</th>
                                <th>Reg ID</th>
                                <th>นักวิ่ง</th>
                                <th>จำนวนเงิน</th>
                                <th>วิธีการชำระ</th>
                                <th>วันเวลาที่ชำระ</th>
                                <th>รหัสอ้างอิง</th>
                                <th>สถานะ</th>
                                <th class="text-center">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody id="payments-table">
                            <% if (payments.length > 0) { %>
                                <% payments.forEach(function(payment) { %>
                                    <tr data-status="<%= payment.status %>" data-method="<%= payment.payment_method %>">
                                        <td class="fw-bold">#<%= payment.payment_id %></td>
                                        <td>#<%= payment.reg_id %></td>
                                        <td><%= payment.first_name %> <%= payment.last_name %></td>
                                        <td class="fw-bold"><%= Number(payment.total_amount).toFixed(2) %> บาท</td>
                                        <td><span class="badge bg-light text-dark border"><%= payment.payment_method %></span></td>
                                        <td><%= payment.payment_time %></td>
                                        <td><code><%= payment.transaction_ref || '-' %></code></td>
                                        <td>
                                            <% if (payment.status === 'Success') { %>
                                                <span class="badge bg-success">สำเร็จ</span>
                                            <% } else if (payment.status === 'Pending') { %>
                                                <span class="badge bg-warning text-dark">รอตรวจสอบ</span>
                                            <% } else { %>
                                                <span class="badge bg-danger"><%= payment.status %></span>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <button class="btn btn-sm btn-warning" onclick="editPayment(<%= payment.payment_id %>)" title="แก้ไข">
                                                    <i class="fa-solid fa-edit"></i>
                                                </button>
                                                <% if (payment.status === 'Pending') { %>
                                                    <button class="btn btn-sm btn-success" onclick="approvePayment(<%= payment.payment_id %>)" title="อนุมัติ">
                                                        <i class="fa-solid fa-check"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-danger" onclick="rejectPayment(<%= payment.payment_id %>)" title="ปฏิเสธ">
                                                        <i class="fa-solid fa-times"></i>
                                                    </button>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="9" class="text-center py-4 text-muted">ไม่มีรายการการชำระเงิน</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="editModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">แก้ไขข้อมูลการชำระเงิน</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="edit-form">
                        <input type="hidden" id="edit-payment-id">
                        <div class="mb-3">
                            <label class="form-label">จำนวนเงิน (บาท)</label>
                            <input type="number" step="0.01" class="form-control" id="edit-amount">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">วิธีการชำระ</label>
                            <select class="form-select" id="edit-method">
                                <option value="Bank Transfer">โอนเงิน (Bank Transfer)</option>
                                <option value="QR Code">QR Code</option>
                                <option value="Cash">เงินสด (Cash)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">สถานะ</label>
                            <select class="form-select" id="edit-status">
                                <option value="Pending">รอตรวจสอบ (Pending)</option>
                                <option value="Success">สำเร็จ (Success)</option>
                                <option value="Failed">ไม่สำเร็จ (Failed)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">หมายเลขอ้างอิง (Transaction Ref)</label>
                            <input type="text" class="form-control" id="edit-ref">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="button" class="btn btn-primary" onclick="savePaymentChanges()">บันทึก</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="assets/js/alert-popup.js"></script>
    <script>
        function applyFilters() {
            const status = document.getElementById('status-filter').value;
            const method = document.getElementById('method-filter').value;
            const search = document.getElementById('search-input').value.toLowerCase();
            const rows = document.querySelectorAll('#payments-table tr');

            rows.forEach(r => {
                let show = true;
                if (status && r.dataset.status !== status) show = false;
                if (method && r.dataset.method !== method) show = false;
                if (search && !r.textContent.toLowerCase().includes(search)) show = false;
                r.style.display = show ? '' : 'none';
            });
        }

        function editPayment(id) {
            fetch(`crud_payment.php?action=get&id=${id}`)
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        const p = res.data;
                        document.getElementById('edit-payment-id').value = p.payment_id;
                        document.getElementById('edit-amount').value = p.total_amount;
                        document.getElementById('edit-method').value = p.payment_method;
                        document.getElementById('edit-status').value = p.status;
                        document.getElementById('edit-ref').value = p.transaction_ref || '';

                        new bootstrap.Modal(document.getElementById('editModal')).show();
                    }
                });
        }

        function savePaymentChanges() {
            const id = document.getElementById('edit-payment-id').value;
            const amount = document.getElementById('edit-amount').value;
            const method = document.getElementById('edit-method').value;
            const status = document.getElementById('edit-status').value;
            const ref = document.getElementById('edit-ref').value;

            fetch('crud_payment.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `action=update&payment_id=${id}&total_amount=${amount}&payment_method=${method}&status=${status}&transaction_ref=${ref}`
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    showSuccess(res.message, 'สำเร็จ', () => location.reload());
                } else {
                    showError(res.message);
                }
            });
        }

        function approvePayment(id) {
            showConfirm('คุณต้องการอนุมัติการชำระเงินนี้ และปรับสถานะการสมัครเป็นชำระแล้วหรือไม่?', 'อนุมัติการชำระเงิน', () => {
                fetch('crud_payment.php', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `action=update_status&payment_id=${id}&status=Success`
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        showSuccess('อนุมัติการชำระเงินเรียบร้อยแล้ว', 'สำเร็จ', () => location.reload());
                    } else {
                        showError(res.message);
                    }
                });
            });
        }

        function rejectPayment(id) {
            showConfirm('คุณต้องการปฏิเสธการชำระเงินนี้ใช่หรือไม่?', 'ปฏิเสธการชำระเงิน', () => {
                fetch('crud_payment.php', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `action=update_status&payment_id=${id}&status=Failed`
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        showSuccess('ปฏิเสธการชำระเงินเรียบร้อยแล้ว', 'สำเร็จ', () => location.reload());
                    } else {
                        showError(res.message);
                    }
                });
            });
        }
    </script>
</body>

</html>
